@model ClientMVC.Models.UserProfileViewModel
@{
    ViewData["Title"] = "Profile";
}
<div class="container py-2">
    <div class="card h-100 shadow-sm">
        <div class="card-header">
            <h5>Profile</h5>
        </div>
        <div class="card-body">
            <dl class="row"> 
                <dt class="col-sm-2">Username: </dt>
                <dd class="col-sm-10">@Model.UserName</dd>
                <dt class="col-sm-2">Full Name: </dt>
                <dd class="col-sm-10">@Model.FullName</dd>
                <dt class="col-sm-2">Email</dt>
                <dd class="col-sm-10">@Model.Email</dd>
                <dt class="col-sm-2">Role: </dt>
                <dd class="col-sm-10">@string.Join(", ", Model.Roles)</dd>
                <dt class="col-sm-2">Date of Birth: </dt>
                <dd class="col-sm-10">@Model.DateOfBirth.ToString("yyy/MM/dd")</dd>
            </dl>
        </div>
        <div class="card-footer">
            <a asp-action="Index" asp-controller="UserTaskSummary" class="btn btn-secondary">Back</a>
        </div>
    </div>
</div>