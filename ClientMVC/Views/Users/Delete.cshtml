@model ClientMVC.Models.UserViewModel
@{
    ViewData["Title"] = "Delete User";
}

<div class="container py-2">
    <div class="card p-2 align-content-center">
        <div class="card-header">
            <h2>Delete User</h2>
        </div>
        <div class="card-body">
            <h4>Are you sure you want to delete this user?</h4>
            <dl class="row">
                <dt class="col-sm-2">UserName</dt>
                <dd class="col-sm-10">@Model.UserName</dd>
                <dt class="col-sm-2">Full Name</dt>
                <dd class="col-sm-10">@Model.FullName</dd>
                <dt class="col-sm-2">Email</dt>
                <dd class="col-sm-10">@Model.Email</dd>
                <dt class="col-sm-2">Roles</dt>
                <dd class="col-sm-10">@Model.RoleName</dd>
            </dl>
            <form asp-action="DeleteConfirmed" method="post" id="userDeleteForm">
                <input type="hidden" asp-for="UserId" />
                <button type="submit" class="btn btn-danger  mt-2">Delete</button>
                <a asp-action="Index" class="btn btn-secondary  mt-2">Back to List</a>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/pagescript/user/Delete.js"></script>
    <script>
        $(document).ready(function(){
            var deleteUser = new UserDelete();
            deleteUser.init();
        });
    </script>
}