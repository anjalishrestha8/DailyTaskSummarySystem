@model ClientMVC.Models.UserViewModel
<div class="modal fade" id="updateUserRoleModal" tabindex="-1" aria-hidden="true" data-bs-backdrop='static'>
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="updateUserRoleForm">
                <div class="modal-header">
                    <h5 class="modal-title">Assign Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="UserId" name="UserId" value="@Model.UserId" />
                    <div class="form-group ">
                        <label asp-for="RoleName"></label>
                        <select asp-for="RoleName" class="form-control select2" asp-items="@(new SelectList(Model.Roles))">
                            <option value="">-- Select Role --</option>
                        </select>
                        <span asp-validation-for="RoleName" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
