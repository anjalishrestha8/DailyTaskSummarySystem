@model List<ClientMVC.Models.UserViewModel>
@{
    ViewData["Title"] = "Users";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <button id="openAdminRegisterUserModal" class="btn btn-success adminRegisterUserBtn">Register New User</button>
</div>
<div class="container py-2">
    <table class="table table-bordered" id="userTable">
        <thead>
            <tr>
                <th>Username</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@string.Join(", ", user.Roles)</td>
                    <td>
                        <button data-id="@user.UserId" class="btn btn-sm btn-primary updateUserRoleBtn">
                            Assign Role
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div>
        <a asp-action="Index" asp-controller="UserTaskSummary" class="btn btn-secondary">Back</a>
    </div>
</div>
@section Scripts
{
    <script src="~/pagescript/user/index.js"></script>
    <script>
        $(document).ready(function(){
            var userIndex = new UserIndex();
            userIndex.init();
        });
    </script>
}