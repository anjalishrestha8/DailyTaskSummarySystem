@model ClientMVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
    ViewData["HideNavbar"] = true;

}
<div class="container d-flex py-5 mt-5 justify-content-center align-items-center">
    <div class="card shadow-lg" style="width: 400px;">
        <div class="card-header text-center">
            <h4>Login</h4>
        </div>

        <div class="card-body">
            <form asp-action="Login" method="post" id="loginForm">
                <div class="form-group mb-3">
                    <label asp-for="UserNameOrEmail" class="form-label">Username or Email:</label>
                    <input asp-for="UserNameOrEmail" class="form-control" />
                    <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <label asp-for="Password" class="form-label">Password:</label>
                    <input asp-for="Password" class="form-control" type="password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary mt-3 w-100">Log In</button>
            </form>
        </div>
        <div class="card-footer text-center text-muted small">
            Forgot password? <a asp-action="ForgotPassword" asp-controller="Account">Forgot Password?</a>
        </div>
        <div class="card-footer text-center text-muted small">
            Don't have an account? <a asp-action="Register" asp-controller="Account">Register</a>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/pagescript/account/login.js"></script>
    <script>
        $(document).ready(function(){
            var login = new Login();
            login.init();
        });
    </script>
}