@using ClientMVC.Common.Enums
@model ClientMVC.Models.PaginatedUserTaskSummaryVm


@if (Model == null || Model.Items == null || !Model.Items.Any())
{
    <div class="text-center mt-5">
        <i class="bi bi-journal-x text-secondary" style="font-size: 3rem;"></i>
        <h4 class="mt-3 text-muted">No results found</h4>
        <br />
    </div>
}
else
{
    @if (User.IsInRole("Admin"))
    {
        foreach (var group in Model!.Items!.GroupBy(s => s.CreatedAt.Date))
        {
            <h6 class="mt-4">
                @if (group.Key == DateTime.UtcNow.Date)
                {
                    <span>Today: @group.Key.ToString("yyyy-MM-dd")</span>
                }
                else if (group.Key == DateTime.UtcNow.AddDays(-1).Date)
                {
                    <span>Yesterday: @group.Key.ToString("yyyy-MM-dd")</span>
                }
                else
                {
                    <span>@group.Key.ToString("yyyy-MM-dd")</span>
                }
            </h6>

            <div class="row">
                @foreach (var summary in group)
                {
                    var colClass = "col-md-3 col-sm-6 mb-4";
                                                             <div class="@colClass">
                                                                 <div class="card h-100 shadow-sm">
                                                                     <div class="card-header">
                                                                         <h5 class="card-title text-sm text-muted">@summary.UserName</h5>
                                                                     </div>
                                                                     <div class="card-body">
                                                                         <h5 class="card-title">@summary.Title</h5>
                                                                         <p class="card-text m-3">@summary.Description</p>
                                                                         <p class="text-muted">
                                                                             <strong>Status: </strong>
                                                                             <span class="badge @(
                                          summary.Status == TaskStatusEnum.Pending ? "bg-danger text-dark" :
                                          summary.Status == TaskStatusEnum.InProgress ? "bg-primary" :
                                          summary.Status == TaskStatusEnum.Completed ? "bg-success" :
                                          "bg-secondary")">@summary.Status</span>
                </p>
                <p class="text-muted small">Created At: @summary.CreatedAt.ToString("yyyy-MM-dd")</p>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-action="Details" asp-route-id="@summary.Id" class="btn btn-sm btn-primary">View Details</a>
            </div>
        </div>
    </div>
        }
            </div>
        }
    }
    else
    {
        <div class="row">
            @foreach (var summary in Model!.Items!)
            {
                var isCreatedToday = summary.CreatedAt.Date == DateTime.UtcNow.Date;
                <div class="col-md-3 col-sm-6 mb-5 mt-2">
                    <h6 class="text-muted">@summary.CreatedAt.ToString("yyyy-MM-dd")</h6>
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            
                            <h5 class="card-title">@summary.Title</h5>
                            <p class="card-text m-3">@summary.Description</p>
                            <p class="text-muted">
                                <strong>Status: </strong>
                                <span class="badge @(
                                      summary.Status == TaskStatusEnum.Pending ? "bg-danger text-dark" :
                                      summary.Status == TaskStatusEnum.InProgress ? "bg-primary" :
                                      summary.Status == TaskStatusEnum.Completed ? "bg-success" :
                                      "bg-secondary")">@summary.Status</span>
                </p>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-action="Details" asp-route-id="@summary.Id" class="btn btn-sm btn-primary">View Details</a>

                @if (isCreatedToday)
                            {
                                <button class="btn btn-warning btn-sm edit-summary" id="editsummary" data-id="@summary.Id" data-title="@summary.Title"
                                        data-description="@summary.Description" data-status="@summary.Status" title="Edit your summary">
                                    Edit
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-5">
        @if (Model.TotalPages >= 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                        <button class="page-link pagination-btn"
                                data-page="@(Model.CurrentPage - 1)"
                                @(Model.HasPrevious ? "" : "disabled")>
                            Previous
                        </button>
                    </li>

                    @{
                        int maxVisiblePages = 3;
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, startPage + maxVisiblePages - 1);

                        if (startPage > 1)
                        {
                            <li class="page-item">
                                <button class="page-link pagination-btn"
                                        data-page="1">
                                    1
                                </button>
                            </li>
                            if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <button class="page-link pagination-btn"
                                        data-page="@i">
                                    @i
                                </button>
                            </li>
                        }
                        if (endPage < Model.TotalPages)
                        {
                            if (endPage < Model.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <button class="page-link pagination-btn"
                                        data-page="@Model.TotalPages">
                                    @Model.TotalPages
                                </button>
                            </li>
                        }
                    }

                    <li class="page-item @(Model.HasNext ? "" : "disabled")">
                        <button class="page-link pagination-btn"
                                data-page="@(Model.CurrentPage + 1)"
                                @(Model.HasNext ? "" : "disabled")>
                            Next
                        </button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}