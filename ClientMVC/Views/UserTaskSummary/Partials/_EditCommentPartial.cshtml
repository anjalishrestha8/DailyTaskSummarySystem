@model ClientMVC.Models.CommentsVm
<div class="modal fade" id="editCommentModal" tabindex="-1" aria-hidden="true" data-bs-backdrop='static'>
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editCommentForm">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Comment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editCommentId" value="@Model.Id" />
                    <input type="hidden" id="editSummaryId" value="@Model.UserTaskSummaryId" />
                    <input type="hidden" id="editCommentUserId" value="@Model.UserId" />
                    <textarea id="editCommentContent" class="form-control" rows="3">@Model.Content</textarea>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
